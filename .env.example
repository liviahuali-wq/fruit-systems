# Copy to .env.local for local development. `supabase status -o env` prints the local values.
# Staging and production values are set in Vercel and GitHub settings, never in this repository.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ENV=development
# Server only, never NEXT_PUBLIC_. Locally: SECRET_KEY from `supabase status`.
# Staging and production: set in Vercel, never in this repository.
SUPABASE_SECRET_KEY=
